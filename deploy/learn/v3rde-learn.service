# LR3: the daily learn report (tools/learn_round.sh). Installed by tools/learn_install.sh, which
# puts the checkout path in place of @ROOT@.
[Unit]
Description=V3RDE learn report (LR3)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/bin/bash "@ROOT@/tools/learn_round.sh"
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=25min
